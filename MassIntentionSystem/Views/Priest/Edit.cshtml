@model MassIntentionSystem.Models.Priest
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Priest Details";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <h4 class="fw-bold mb-3" style="color: #4a154b;">✏️ Edit Impormasyon ng Pari</h4>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Pangalan</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active Status</label>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Bumalik</a>
                        <button type="submit" class="btn btn-success fw-bold">I-update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>