@model MassIntentionSystem.Models.Priest
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Magdagdag ng Pari";
}

<div class="row justify-content-center fade-up">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold font-display text-navy m-0">Magdagdag ng Bagong Pari</h4>
            <a asp-action="Index" class="btn btn-sd-outline btn-sm"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
        </div>

        <form asp-action="Create" method="post" class="sd-card shadow-md-sd p-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <div class="sd-field">
                    <i class="bi bi-person-vcard sd-icon"></i>
                    <input asp-for="Name" class="form-control" placeholder=" " required />
                    <label asp-for="Name">Rev. Fr. Juan Dela Cruz, OP</label>
                </div>
            </div>
            <div class="mb-4">
                <div class="sd-field">
                    <i class="bi bi-envelope sd-icon"></i>
                    <input asp-for="Email" type="email" class="form-control" placeholder=" " />
                    <label asp-for="Email">Email (Optional)</label>
                </div>
            </div>
            <div class="form-check p-3 rounded-2xl mb-4" style="background:var(--sd-bg);">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label fw-semibold">Active (Maaaring itaga sa Misa)</label>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-sd-outline">Kanselahin</a>
                <button type="submit" class="btn btn-sd-primary px-4"><i class="bi bi-save me-1"></i> I-save</button>
            </div>
        </form>
    </div>
</div>