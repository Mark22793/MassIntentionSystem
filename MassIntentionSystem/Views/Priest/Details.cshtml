@model MassIntentionSystem.Models.Priest
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Priest Details";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <h4 class="fw-bold mb-3" style="color: #4a154b;">⛪ Detalye ng Pari</h4>
                <div class="mb-3">
                    <span class="text-muted d-block">Pangalan:</span>
                    <strong class="fs-5">@Model.Name</strong>
                </div>
                <div class="mb-3">
                    <span class="text-muted d-block">Email:</span>
                    <span>@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</span>
                </div>
                <div class="mb-4">
                    <span class="text-muted d-block">Status:</span>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "Active Celebrant" : "Inactive")
                    </span>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">← Bumalik</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">Edit</a>
                </div>
            </div>
        </div>
    </div>
</div>