@model IEnumerable<MassIntentionSystem.Models.MassSchedule>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Schedules Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0" style="color: #4a154b;">📅 Mass Schedules & Priests Report</h3>
    <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ I-print Report</button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Araw (Day)</th>
                    <th>Oras (Time)</th>
                    <th>Wika (Language)</th>
                    <th>Nagmimisang Pari (Priest)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.DayOfWeek</strong></td>
                        <td>@DateTime.Today.Add(item.Time).ToString("hh:mm tt")</td>
                        <td>@item.Language</td>
                        <td>@(item.Priest?.Name ?? "Unassigned")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>