@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports Dashboard";
}

<div class="mb-4">
    <h3 class="fw-bold" style="color: #4a154b;">📊 System Reports Dashboard</h3>
    <p class="text-muted small">Pumili ng uri ng report na nais mong tingnan o i-export.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3 text-center">
            <div class="display-5 text-purple mb-2">📜</div>
            <h5 class="fw-bold">Intentions Report</h5>
            <p class="text-muted small">Talaan ng lahat ng Mass Intentions ayon sa kategorya at petsa.</p>
            <a asp-action="Intentions" class="btn btn-violet mt-auto fw-bold">Tingnan Report</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3 text-center">
            <div class="display-5 text-success mb-2">💰</div>
            <h5 class="fw-bold">Payments Report</h5>
            <p class="text-muted small">Buod ng mga natanggap na stipend/donations mula sa GCash at Maya.</p>
            <a asp-action="Payments" class="btn btn-violet mt-auto fw-bold">Tingnan Report</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3 text-center">
            <div class="display-5 text-warning mb-2">📅</div>
            <h5 class="fw-bold">Schedules Report</h5>
            <p class="text-muted small">Talaan ng Mass Schedules at assigned Officiating Priests.</p>
            <a asp-action="Schedules" class="btn btn-violet mt-auto fw-bold">Tingnan Report</a>
        </div>
    </div>
</div>