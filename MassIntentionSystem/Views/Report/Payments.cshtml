@model IEnumerable<MassIntentionSystem.Models.Payment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payments Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0" style="color: #4a154b;">💰 Financial & Payments Report</h3>
    <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ I-print Report</button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Ref No</th>
                    <th>Petsa ng Bayad</th>
                    <th>Halaga</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pay in Model)
                {
                    <tr>
                        <td><strong>@pay.MassIntention?.ReferenceNo</strong></td>
                        <td>@pay.PaymentDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                        <td class="text-success fw-bold">₱@pay.Amount.ToString("N2")</td>
                        <td><span class="badge bg-success">Verified</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>