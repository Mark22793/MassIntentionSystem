@model IEnumerable<MassIntentionSystem.Models.MassIntention>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Intentions Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0" style="color: #4a154b;">📜 Mass Intentions Report</h3>
    <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ I-print Report</button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Ref Code</th>
                    <th>Petsa ng Misa</th>
                    <th>Oras</th>
                    <th>Kategorya</th>
                    <th>Mga Pangalan</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.ReferenceNo</strong></td>
                        <td>@item.MassDate.ToString("yyyy-MM-dd")</td>
                        <td>@DateTime.Today.Add(item.MassTime).ToString("hh:mm tt")</td>
                        <td>@item.Category</td>
                        <td>@item.OfferingNames</td>
                        <td><span class="badge bg-secondary">@item.PaymentStatus</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>