@model MassIntentionSystem.Models.MassIntention
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "I-edit ang Mass Intention";

    string currentTime = Model.MassTime.ToString(@"hh\:mm\:ss");
    var times = new (string val, string label)[]
    {
        ("06:00:00","6:00 AM"), ("07:30:00","7:30 AM"), ("09:00:00","9:00 AM"),
        ("10:30:00","10:30 AM"), ("12:00:00","12:00 PM"), ("16:00:00","4:00 PM"),
        ("17:30:00","5:30 PM"), ("19:00:00","7:00 PM")
    };
    bool isPaid = Model.PaymentStatus is "Verified" or "Confirmed" or "CONFIRMED / PAID" or "Paid";
    bool isCancelled = Model.PaymentStatus == "Cancelled";
    decimal currentAmount = Model.Payment?.Amount ?? 0m;
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold m-0 text-navy"><i class="bi bi-pencil-square text-gold me-2"></i>I-edit ang Mass Intention</h4>
            <small class="text-muted">Ref No: <strong>@Model.ReferenceNo</strong></small>
        </div>
        <a asp-action="Index" class="btn btn-sd-outline"><i class="bi bi-arrow-left me-1"></i> Bumalik sa Listahan</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" novalidate>
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Requester Information -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h6 class="fw-bold text-navy m-0"><i class="bi bi-person-lines-fill text-gold me-2"></i>Requester Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="RequestorName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="RequestorName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ContactNumber" class="form-label fw-semibold">Contact Number <span class="text-danger">*</span></label>
                            <input asp-for="ContactNumber" class="form-control" required />
                        </div>
                        <div class="mb-0">
                            <label asp-for="RequestorEmail" class="form-label fw-semibold">Email <span class="text-muted small">(optional)</span></label>
                            <input asp-for="RequestorEmail" type="email" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mass Information -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h6 class="fw-bold text-navy m-0"><i class="bi bi-calendar-event text-gold me-2"></i>Mass Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="MassDate" class="form-label fw-semibold">Mass Date <span class="text-danger">*</span></label>
                                <input asp-for="MassDate" type="date" class="form-control" value="@Model.MassDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Mass Time <span class="text-danger">*</span></label>
                                <select name="rawMassTime" class="form-select" required>
                                    @foreach (var t in times)
                                    {
                                        if (t.val == currentTime)
                                        {
                                            <option value="@t.val" selected>@t.label</option>
                                        }
                                        else
                                        {
                                            <option value="@t.val">@t.label</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="PriestName" class="form-label fw-semibold">Priest / Celebrant</label>
                                <select asp-for="PriestName" class="form-select">
                                    <option value="">-- Pumili ng Pari (Optional) --</option>
                                    @if (ViewBag.Priests != null)
                                    {
                                        foreach (var priest in (IEnumerable<MassIntentionSystem.Models.Priest>)ViewBag.Priests)
                                        {
                                            if (priest.Name == Model.PriestName)
                                            {
                                                <option value="@priest.Name" selected>Fr. @priest.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@priest.Name">Fr. @priest.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Intention Information -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h6 class="fw-bold text-navy m-0"><i class="bi bi-journal-text text-gold me-2"></i>Intention Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold">Intention Category <span class="text-danger">*</span></label>
                            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<MassIntentionSystem.Models.IntentionCategory>()"></select>
                        </div>
                        <div class="mb-0">
                            <label asp-for="OfferingNames" class="form-label fw-semibold">Names / Persons Included <span class="text-danger">*</span></label>
                            <textarea asp-for="OfferingNames" class="form-control" rows="5" required placeholder="Isang pangalan bawat linya..."></textarea>
                            <div class="form-text">Isulat ang bawat pangalan sa magkahiwalay na linya.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment & Status -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h6 class="fw-bold text-navy m-0"><i class="bi bi-cash-coin text-gold me-2"></i>Payment &amp; Status</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label for="amount" class="form-label fw-semibold">Amount / Offering (₱)</label>
                                <input type="number" step="0.01" min="0" name="amount" id="amount" class="form-control" value="@currentAmount.ToString("0.00")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold">Status</label>
                                <select name="PaymentStatus" class="form-select">
                                    <option value="Pending" selected="@(!isPaid && !isCancelled)">PENDING</option>
                                    <option value="CONFIRMED / PAID" selected="@isPaid">CONFIRMED / PAID</option>
                                    <option value="Cancelled" selected="@isCancelled">CANCELLED</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="bg-light rounded p-3 small text-muted">
                                    <div><i class="bi bi-hash me-1"></i>Reference: <strong class="text-navy">@Model.ReferenceNo</strong></div>
                                    <div><i class="bi bi-clock-history me-1"></i>Date Created: <strong class="text-navy">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</strong></div>
                                    <div><i class="bi bi-person-check me-1"></i>Source: <strong class="text-navy">@(Model.IsAdminEncoded ? "Walk-in (Admin)" : "Online")</strong></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-sd-outline"><i class="bi bi-x-lg me-1"></i> Kanselahin</a>
            <button type="submit" class="btn btn-navy px-4" id="saveBtn">
                <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner" role="status" aria-hidden="true"></span>
                <i class="bi bi-check-circle me-1" id="saveIcon"></i> I-save ang Pagbabago
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('editForm');
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add('was-validated');
                    return;
                }
                const btn = document.getElementById('saveBtn');
                document.getElementById('saveSpinner').classList.remove('d-none');
                document.getElementById('saveIcon').classList.add('d-none');
                btn.disabled = true;
                btn.querySelector('span.spinner-border')?.classList.remove('d-none');
                btn.insertAdjacentText('beforeend', ' Sinasave...');
            });
        })();
    </script>
}
