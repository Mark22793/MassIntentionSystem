@model MassIntentionSystem.Models.MassIntention

@{
    ViewData["Title"] = "Intention Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Detalye ng Mass Intention</h4>
                    <span class="badge bg-light text-primary fs-6">@Model.ReferenceNo</span>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Petsa ng Misa:</strong>
                            <p class="text-muted">@Model.MassDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Oras ng Misa:</strong>
                            <p class="text-muted">@Model.MassTime</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Kategorya:</strong>
                            <p class="text-muted">@Model.Category</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <p>
                                <span class="badge bg-warning text-dark">@Model.PaymentStatus</span>
                            </p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Mga Pangalan na Ipagdarasal:</strong>
                        <div class="p-3 bg-light rounded border text-secondary">
                            @Model.OfferingNames
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Nag-request:</strong>
                            <p class="text-muted">@Model.RequestorName</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Contact:</strong>
                            <p class="text-muted">@Model.ContactNumber</p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Track" class="btn btn-outline-secondary">Mag-track ng Iba</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Bumalik sa Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>