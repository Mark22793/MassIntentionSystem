@{
    ViewData["Title"] = "I-track ang Mass Intention";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4">
                <div class="card-body text-center">
                    <h3 class="fw-bold mb-2" style="color: #4a154b;">🔍 Track Your Mass Intention</h3>
                    <p class="text-muted small mb-4">I-enter ang Reference Code na ibinigay pagkatapos mag-submit.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center" role="alert">
                            <small>@ViewBag.Error</small>
                        </div>
                    }

                    <form asp-controller="MassIntention" asp-action="Track" method="post">
                        <div class="mb-3">
                            <input type="text" name="referenceNo" class="form-control form-control-lg text-center fw-bold" placeholder="Halimbawa: SD-2026-X89A" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-violet btn-lg fw-bold">
                                Hanapin ang Intention
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>