@model MassIntentionSystem.Models.MassIntention

@{
    ViewData["Title"] = "Admin Encoding - Mass Intention";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Admin Encoding (Walk-in Intention)</h4>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="AdminCreate" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="RequestorName" class="form-label fw-bold">Pangalan ng Nagpapamisa (Requestor Name)</label>
                        <input asp-for="RequestorName" class="form-control" placeholder="hal. Juan Dela Cruz" required />
                        <span asp-validation-for="RequestorName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactNumber" class="form-label fw-bold">Contact Number</label>
                        <input asp-for="ContactNumber" class="form-control" placeholder="hal. 09123456789" />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="MassDate" class="form-label fw-bold">Petsa ng Misa</label>
                        <input asp-for="MassDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="MassDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Oras ng Misa</label>
                        <select name="rawMassTime" class="form-select" required>
                            <option value="06:00:00">6:00 AM</option>
                            <option value="07:30:00">7:30 AM</option>
                            <option value="09:00:00">9:00 AM</option>
                            <option value="10:30:00">10:30 AM</option>
                            <option value="12:00:00">12:00 PM</option>
                            <option value="16:00:00">4:00 PM</option>
                            <option value="17:30:00">5:30 PM</option>
                            <option value="19:00:00">7:00 PM</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PriestName" class="form-label fw-bold">Pari (Officiating Priest)</label>
                        <select asp-for="PriestName" class="form-select">
                            <option value="">-- Pumili ng Pari (Optional) --</option>
                            @if (ViewBag.Priests != null)
                            {
                                foreach (var priest in (IEnumerable<MassIntentionSystem.Models.Priest>)ViewBag.Priests)
                                {
                                    <option value="@priest.Name">Fr. @priest.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PriestName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-bold">Kategorya (Category)</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<MassIntentionSystem.Models.IntentionCategory>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label for="amountPaid" class="form-label fw-bold">Halaga na Bayad (Amount Paid - ₱)</label>
                        <input type="number" step="0.01" name="amountPaid" id="amountPaid" class="form-control" value="100.00" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="OfferingNames" class="form-label fw-bold">Mga Pangalan na Isasama sa Misa (Offering Names)</label>
                    <textarea asp-for="OfferingNames" class="form-control" rows="4" placeholder="Ilista ang mga pangalan dito..." required></textarea>
                    <span asp-validation-for="OfferingNames" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
                    <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-circle me-1"></i> I-save at I-print ang Resibo</button>
                </div>
            </form>
        </div>
    </div>
</div>