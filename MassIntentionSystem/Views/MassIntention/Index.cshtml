@model IEnumerable<MassIntentionSystem.Models.MassIntention>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mass Intentions Masterlist";

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? Model.Count();
    string curSearch = ViewBag.CurrentSearch as string;
    string curStatus = ViewBag.CurrentStatus as string;
    string curDate = ViewBag.CurrentDate as string;

    string CatSlug(MassIntentionSystem.Models.IntentionCategory c) => c.ToString().Replace(" ", "").ToLower();
}

<style>
    .badge-category-eternalrepose { background-color:#6c757d !important; color:#fff !important; }
    .badge-category-healing { background-color:#198754 !important; color:#fff !important; }
    .badge-category-thanksgiving { background-color:#0d6efd !important; color:#fff !important; }
    .badge-category-other { background-color:#0dcaf0 !important; color:#212529 !important; }
    .offering-preview { max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .action-cell .btn { --bs-btn-padding-y:.25rem; --bs-btn-padding-x:.45rem; }
</style>

<div class="container-fluid py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">

        <!-- Header -->
        <div class="card-header bg-white py-3 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="fw-bold m-0 text-navy">
                    <i class="bi bi-journal-text text-gold me-2"></i>Mass Intentions Masterlist
                </h4>
                <small class="text-muted">Talaan ng lahat ng walk-in at online mass intentions &mdash; <strong>@totalCount</strong> total.</small>
            </div>
            <div class="d-flex gap-2">
                @if (totalCount > 0)
                {
                    <form asp-action="DeleteAllFiltered" method="post"
                          onsubmit="return confirm('BABALA: Buburahin ang LAHAT ng @totalCount na record sa kasalukuyang filter. Hindi na ito mababawi. Magpatuloy?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="searchString" value="@curSearch" />
                        <input type="hidden" name="status" value="@curStatus" />
                        <input type="hidden" name="searchDate" value="@curDate" />
                        <button type="submit" class="btn btn-outline-danger fw-semibold px-3">
                            <i class="bi bi-trash3-fill me-1"></i> Delete All (@totalCount)
                        </button>
                    </form>
                }
                <a asp-action="AdminCreate" class="btn btn-navy fw-semibold px-3">
                    <i class="bi bi-plus-lg me-1"></i>Bagong Walk-in
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card-body border-bottom bg-light py-3">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4 col-lg-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchString" value="@curSearch" class="form-control border-start-0" placeholder="Search Ref No. / Pangalan / Contact..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar3 text-muted"></i></span>
                            <input type="date" name="searchDate" value="@curDate" class="form-control border-start-0" onchange="this.form.submit()" title="Petsa ng Misa" />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-3">
                        <select name="status" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Lahat ng Status --</option>
                            <option value="Paid" selected="@(curStatus == "Paid")">CONFIRMED / PAID</option>
                            <option value="Pending" selected="@(curStatus == "Pending")">PENDING</option>
                            <option value="Cancelled" selected="@(curStatus == "Cancelled")">CANCELLED</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-lg-2 d-flex gap-1">
                        <button type="submit" class="btn btn-navy fw-semibold flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-sd-outline d-flex align-items-center" title="Clear All Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sd table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Ref No.</th>
                            <th>Client / Requestor</th>
                            <th>Petsa &amp; Oras</th>
                            <th>Pari</th>
                            <th>Intention</th>
                            <th class="text-end">Halaga</th>
                            <th>Status</th>
                            <th class="text-center" style="min-width:210px;">Aksyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool paid = item.PaymentStatus is "Verified" or "Confirmed" or "CONFIRMED / PAID" or "Paid";
                            <tr>
                                <td class="ps-4">
                                    <strong style="color:#d97706;">@item.ReferenceNo</strong><br />
                                    <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-navy">@item.RequestorName</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.ContactNumber) ? "Walang Contact" : item.ContactNumber)</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.MassDate.ToString("MMM dd, yyyy")</div>
                                    <span class="badge bg-light text-dark border rounded-pill px-2">@DateTime.Today.Add(item.MassTime).ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.PriestName))
                                    {
                                        <span class="text-muted small fst-italic">Hindi pa nakatalaga</span>
                                    }
                                    else
                                    {
                                        <span class="small">Fr. @item.PriestName</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-category-@CatSlug(item.Category) rounded-pill px-3 py-2">@item.Category</span>
                                    <div class="offering-preview small text-muted mt-1" title="@item.OfferingNames">@item.OfferingNames.Replace("\n", ", ")</div>
                                </td>
                                <td class="text-end">
                                    @if (item.Payment != null && item.Payment.Amount > 0)
                                    {
                                        <span class="fw-semibold">₱@item.Payment.Amount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (paid)
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-3 py-2">CONFIRMED / PAID</span>
                                    }
                                    else if (item.PaymentStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-2">CANCELLED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">PENDING</span>
                                    }
                                </td>
                                <td class="text-center pe-4 action-cell">
                                    <div class="d-flex justify-content-center align-items-center flex-wrap gap-1">
                                        @if (!paid)
                                        {
                                            <form asp-action="ApproveByRef" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="referenceNo" value="@item.ReferenceNo" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-3" title="Approve lahat ng misa sa Ref No. na ito"
                                                        onclick="return confirm('I-aprubahan ang LAHAT ng misa para sa Ref No: @item.ReferenceNo?');">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Tingnan ang Detalye">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-3" title="I-edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Certificate" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-warning rounded-3" title="Mass Intention Certificate">
                                            <i class="bi bi-award-fill"></i>
                                        </a>
                                        <a asp-action="PrintReceipt" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3" title="I-print ang Resibo">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Sigurado ka bang buburahin ang Mass Intention na ito? Hindi na ito mababawi.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Burahin">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                    Walang nahanap na Mass Intentions sa kasalukuyang filter.
                                    <div class="mt-3">
                                        <a asp-action="Index" class="btn btn-sm btn-sd-outline"><i class="bi bi-arrow-counterclockwise me-1"></i>I-reset ang Filter</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 d-flex flex-wrap justify-content-between align-items-center py-3">
                <small class="text-muted">Pahina @(page) ng @totalPages</small>
                <nav aria-label="Pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-searchString="@curSearch" asp-route-status="@curStatus" asp-route-searchDate="@curDate"
                               asp-route-page="@(page - 1)"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @{
                            int start = Math.Max(1, page - 2);
                            int end = Math.Min(totalPages, start + 4);
                            start = Math.Max(1, end - 4);
                        }
                        @for (int p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-searchString="@curSearch" asp-route-status="@curStatus" asp-route-searchDate="@curDate"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-searchString="@curSearch" asp-route-status="@curStatus" asp-route-searchDate="@curDate"
                               asp-route-page="@(page + 1)"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
