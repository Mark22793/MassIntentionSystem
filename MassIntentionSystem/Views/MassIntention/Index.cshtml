@model IEnumerable<MassIntentionSystem.Models.MassIntention>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mass Intentions Masterlist";
}

<style>
    .badge-category-eternalrepose,
    .badge-category-eternal-repose,
    .badge-category-soul {
        background-color: #6c757d !important;
        color: #ffffff !important;
    }
    .badge-category-healing {
        background-color: #198754 !important;
        color: #ffffff !important;
    }
    .badge-category-thanksgiving {
        background-color: #0d6efd !important;
        color: #ffffff !important;
    }
    .badge-category-specialintention {
        background-color: #0dcaf0 !important;
        color: #212529 !important;
    }
</style>

<div class="container-fluid py-4">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card -->
    <div class="card border-0 shadow-sm rounded-3">
        
        <!-- Header Actions -->
        <div class="card-header bg-white py-3 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="fw-bold m-0" style="color: #1e293b;">
                    <i class="bi bi-journal-text text-primary me-2"></i>Mass Intentions Masterlist
                </h4>
                <small class="text-muted">Talaan ng lahat ng walk-in at online mass intentions.</small>
            </div>
            <div class="d-flex gap-2">
                <!-- Delete All Filtered/Shown Items Button -->
                @if (Model.Any())
                {
                    <form asp-action="DeleteAllFiltered" method="post" onsubmit="return confirm('WARNING: Sigurado ka bang gusto mong burahin ang LAHAT ng @Model.Count() na nakatala sa listahang ito? Hindi na ito mababawi.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="searchString" value="@ViewBag.CurrentSearch" />
                        <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
                        <input type="hidden" name="searchDate" value="@ViewBag.CurrentDate" />
                        <button type="submit" class="btn btn-outline-danger fw-bold px-3">
                            <i class="bi bi-trash3-fill me-1"></i> Delete All (@Model.Count())
                        </button>
                    </form>
                }

                <a asp-action="AdminCreate" class="btn btn-primary fw-bold px-3">
                    <i class="bi bi-plus-lg me-1"></i>Bagong Walk-in
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card-body border-bottom bg-light py-3">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-2 align-items-center">
                    
                    <!-- Search Input -->
                    <div class="col-md-4 col-lg-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="searchInput" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Search Ref No. / Pangalan..." onkeyup="filterTableLocally()" />
                        </div>
                    </div>

                    <!-- Date Input -->
                    <div class="col-md-3 col-lg-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar3 text-muted"></i></span>
                            <input type="date" id="searchDateInput" name="searchDate" value="@ViewBag.CurrentDate" class="form-control border-start-0" onchange="this.form.submit()" title="Petsa ng Misa" />
                        </div>
                    </div>

                    <!-- Status Dropdown -->
                    <div class="col-md-3 col-lg-3">
                        <select id="statusSelect" name="status" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Lahat ng Status --</option>
                            <option value="Paid" selected="@(ViewBag.CurrentStatus == "Paid")">CONFIRMED / PAID</option>
                            <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">PENDING</option>
                            <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">CANCELLED</option>
                        </select>
                    </div>

                    <!-- Filter & Clear All Filters Buttons -->
                    <div class="col-md-2 col-lg-3 d-flex gap-1">
                        <button type="submit" class="btn btn-primary fw-semibold flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        
                        <!-- Clear All Filters Button -->
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1" title="Clear All Filters">
                            <i class="bi bi-x-circle-fill"></i> Clear All
                        </a>
                    </div>

                </div>
            </form>
        </div>

        <!-- Table Content -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sd table-hover align-middle mb-0" id="intentionsTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Ref No.</th>
                            <th>Client / Requestor</th>
                            <th>Petsa at Oras ng Misa</th>
                            <th>Kategorya</th>
                            <th>Status ng Bayad</th>
                            <th class="text-center" style="width:200px;">Aksyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong class="text-gold" style="color: #d97706;">@item.ReferenceNo</strong><br />
                                    <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-navy" style="color: #0f172a;">@item.RequestorName</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.ContactNumber) ? "Walang Contact" : item.ContactNumber)</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.MassDate.ToString("MMM dd, yyyy")</div>
                                    <span class="badge bg-light text-dark border rounded-pill px-2">@DateTime.Today.Add(item.MassTime).ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    @{
                                        var catSlug = item.Category.ToString().Replace(" ", "").ToLower();
                                    }
                                    <span class="badge badge-category-@catSlug bg-secondary text-white rounded-pill px-3 py-2">
                                        @item.Category
                                    </span>
                                </td>
                                <td>
                                    @if (item.PaymentStatus is "Verified" or "Confirmed" or "CONFIRMED / PAID" or "Paid")
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-3 py-2">CONFIRMED / PAID</span>
                                    }
                                    else if (item.PaymentStatus is "Cancelled")
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-2">CANCELLED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">PENDING</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        
                                        @if (item.PaymentStatus is not ("Verified" or "Confirmed" or "CONFIRMED / PAID" or "Paid"))
                                        {
                                            <form asp-action="ApproveByRef" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="referenceNo" value="@item.ReferenceNo" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-3" title="Approve LAHAT ng Misa sa Ref No. na ito" onclick="return confirm('Sigurado ka bang i-aapprove ang LAHAT ng misa para sa Ref No: @item.ReferenceNo?');">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }

                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Tingnan ang Detalye">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <a asp-action="PrintReceipt" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3" title="I-print ang Resibo">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Sigurado ka bang gusto mong burahin ang Mass Intention na ito?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Burahin">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr id="noRecordsRow">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                    Walang nahanap na records sa kasalukuyang filter o database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function filterTableLocally() {
        const input = document.getElementById("searchInput").value.toUpperCase();
        const rows = document.querySelectorAll("#intentionsTable tbody tr");

        rows.forEach(row => {
            if (row.id === "noRecordsRow") return;
            const text = row.textContent || row.innerText;
            if (text.toUpperCase().indexOf(input) > -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }
</script>