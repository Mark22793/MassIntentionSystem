@model IEnumerable<MassIntentionSystem.Models.MassIntention>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mass Intentions Masterlist";
}

<div class="container-fluid py-4">

    <!-- Success / Error Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card border-0 shadow-sm rounded-3">
        
        <!-- Header & Action Button -->
        <div class="card-header bg-white py-3 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="fw-bold m-0" style="color: #1e293b;">
                    <i class="bi bi-journal-text text-primary me-2"></i>Mass Intentions Masterlist
                </h4>
                <small class="text-muted">Talaan ng lahat ng walk-in at online mass intentions.</small>
            </div>
            <a asp-action="AdminCreate" class="btn btn-primary fw-bold px-3">
                <i class="bi bi-plus-lg me-1"></i>Bagong Walk-in
            </a>
        </div>

        <!-- Filter Bar -->
        <div class="card-body border-bottom bg-light py-3">
            <div class="row g-2">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Mag-search ng Ref No. o Pangalan..." onkeyup="filterTable()">
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Content -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="intentionsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Ref No.</th>
                            <th>Client / Requestor</th>
                            <th>Petsa at Oras ng Misa</th>
                            <th>Kategorya</th>
                            <th>Status ng Bayad</th>
                            <th class="text-center" style="width: 160px;">Aksyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <strong class="text-primary">@item.ReferenceNo</strong>
                                    <br />
                                    <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.RequestorName</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.ContactNumber) ? " Walang Contact" : item.ContactNumber)</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.MassDate.ToString("MMM dd, yyyy")</div>
                                    <small class="badge bg-secondary">
                                        @DateTime.Today.Add(item.MassTime).ToString("hh:mm tt")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark px-2 py-1">@item.Category</span>
                                </td>
                                <td>
                                    @if (item.PaymentStatus == "Verified" || item.PaymentStatus == "Confirmed" || item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">CONFIRMED / PAID</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">PENDING</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex justify-content-center gap-1">
                                        <!-- Print Receipt Button -->
                                        <a asp-action="PrintReceipt" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-primary" title="I-print ang Resibo">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>

                                        <!-- Delete Form & Button -->
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Sigurado ka bang gusto mong burahin ang Mass Intention na ito?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Burahin ang Record">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr id="noRecordsRow">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                    Walang nahanap na records sa database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Simple Live Search Script -->
<script>
    function filterTable() {
        const input = document.getElementById("searchInput").value.toUpperCase();
        const rows = document.querySelectorAll("#intentionsTable tbody tr");

        rows.forEach(row => {
            if (row.id === "noRecordsRow") return;
            const text = row.textContent || row.innerText;
            if (text.toUpperCase().indexOf(input) > -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }
</script>