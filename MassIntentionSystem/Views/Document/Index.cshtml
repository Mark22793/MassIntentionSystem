@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Export Mass Intentions";
    var massTimes = new List<string> { "06:00:00", "07:30:00", "09:00:00", "10:30:00", "12:00:00", "16:00:00", "17:30:00", "19:00:00" };
    var massTimeLabels = new List<string> { "06:00 AM", "07:30 AM", "09:00 AM", "10:30 AM", "12:00 PM", "04:00 PM", "05:30 PM", "07:00 PM" };
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h4 class="fw-bold m-0 text-navy">
                <i class="bi bi-file-earmark-word text-primary me-2"></i>Export Mass Intentions
            </h4>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-action="GenerateDoc" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-semibold">Petsa ng Misa</label>
                    <input type="date" name="massDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Piliin ang Oras ng Misa at Nakatokang Pari:</label>
                    <div class="list-group">
                        @for (int i = 0; i < massTimes.Count; i++)
                        {
                            var timeVal = massTimes[i];
                            var label = massTimeLabels[i];
                            <div class="list-group-item d-flex align-items-center justify-content-between py-2">
                                <div class="form-check">
                                    <input class="form-check-input time-checkbox" type="checkbox" name="selectedTimes" value="@timeVal" id="chk_@i" onchange="togglePriestDropdown(@i)">
                                    <label class="form-check-label fw-bold" for="chk_@i">
                                        @label
                                    </label>
                                </div>
                                <div style="width: 55%;">
                                    <select name="priestIds" id="priest_@i" class="form-select form-select-sm" disabled required>
                                        <option value="0">-- Piliin ang Pari --</option>
                                        @if (ViewBag.Priests != null)
                                        {
                                            @foreach (var priest in (IEnumerable<SelectListItem>)ViewBag.Priests)
                                            {
                                                <option value="@priest.Value">@priest.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-3">
                    <i class="bi bi-download me-1"></i> I-generate ang Word Document (.doc)
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function togglePriestDropdown(index) {
        var chk = document.getElementById('chk_' + index);
        var select = document.getElementById('priest_' + index);
        select.disabled = !chk.checked;
        if (!chk.checked) {
            select.value = "0";
        }
    }
</script>