<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Santo Domingo Admin Portal</title>

    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />

    <style>
            body {
                background-color: #f8fafc;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            #sidebar-wrapper {
                background-color: #1e293b !important;
                width: 260px;
                min-height: 100vh;
                transition: all 0.3s ease;
            }

            .sidebar-brand {
                background-color: #0f172a;
                color: #f59e0b;
            }

            .admin-nav-item {
                color: #94a3b8 !important;
                padding: 0.75rem 1.25rem;
                font-weight: 500;
                border: none;
                transition: all 0.2s ease;
            }

                .admin-nav-item:hover,
                .admin-nav-item.active {
                    background-color: rgba(255, 255, 255, 0.08) !important;
                    color: #ffffff !important;
                    border-left: 4px solid #3b82f6;
                }

            .admin-nav-item-highlight {
                color: #f59e0b !important;
                font-weight: 600;
            }

                .admin-nav-item-highlight:hover {
                    background-color: rgba(245, 158, 11, 0.15) !important;
                    color: #fbbf24 !important;
                    border-left: 4px solid #f59e0b;
                }

            #page-content-wrapper {
                background-color: #f8fafc;
                min-height: 100vh;
            }
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar Navigation -->
        <div class="border-end shadow-sm" id="sidebar-wrapper">
            <!-- Header Brand / Logo -->
            <div class="sidebar-brand p-3 border-bottom border-secondary d-flex align-items-center gap-2">
                <i class="bi bi-church fs-3 text-warning"></i>
                <div>
                    <div class="fw-bold fs-6 text-white leading-tight">Santo Domingo</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Admin Management System</small>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="list-group list-group-flush py-2">
                <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>

                <!-- Walk-in Cash Intention Form for Admin -->
                <a asp-controller="MassIntention" asp-action="AdminCreate" class="list-group-item list-group-item-action bg-transparent admin-nav-item admin-nav-item-highlight">
                    <i class="bi bi-plus-circle-fill me-2"></i> New Walk-in (Cash)
                </a>

                <a asp-controller="MassIntention" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-journal-check me-2"></i> Mass Intentions
                </a>
                <a asp-controller="Document" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-file-earmark-word me-2"></i> Export Documents
                </a>
                <a asp-controller="Schedule" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-calendar-event me-2"></i> Schedules
                </a>
                <a asp-controller="Priest" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-person-badge me-2"></i> Priests
                </a>
                <a asp-controller="Report" asp-action="Index" class="list-group-item list-group-item-action bg-transparent admin-nav-item">
                    <i class="bi bi-bar-chart me-2"></i> Reports
                </a>
            </div>

            <!-- Bottom Section: Logout -->
            <div class="mt-auto p-3 border-top border-secondary position-absolute bottom-0 w-100" style="max-width: 260px;">
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger w-100 btn-sm">
                    <i class="bi bi-box-arrow-left me-1"></i> Log out
                </a>
            </div>
        </div>

        <!-- Main Page Content -->
        <div id="page-content-wrapper" class="w-100">
            <main role="main" class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>