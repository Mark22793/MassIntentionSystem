<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F172A" />
    <title>@ViewData["Title"] - Santo Domingo Admin Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-soft">
    <div class="d-flex" id="wrapper">

        <!-- Sidebar -->
        <aside class="d-flex flex-column bg-navy text-white" id="sd-sidebar" style="width:272px; min-height:100vh; position:sticky; top:0;">
            <div class="d-flex align-items-center gap-2 p-4 border-bottom border-white border-opacity-10">
                <span class="d-inline-flex align-items-center justify-content-center rounded-xl"
                      style="width:42px;height:42px;background:linear-gradient(135deg,#F59E0B,#D97706);">
                    <i class="bi bi-church fs-5 text-white"></i>
                </span>
                <div>
                    <div class="fw-bold font-display">Santo Domingo</div>
                    <small class="text-white-50" style="font-size:.72rem;">Admin Management Portal</small>
                </div>
            </div>

            <nav class="flex-grow-1 py-3 px-2 d-flex flex-column gap-1 overflow-auto">
                <small class="text-white-50 text-uppercase px-3 mb-1" style="font-size:.65rem; letter-spacing:.08em;">Overview</small>
                <a asp-controller="Dashboard" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <small class="text-white-50 text-uppercase px-3 mt-3 mb-1" style="font-size:.65rem; letter-spacing:.08em;">Intentions</small>
                <a asp-controller="MassIntention" asp-action="AdminCreate" class="sd-nav-link sd-nav-link-gold">
                    <i class="bi bi-plus-circle-fill"></i> New Walk-in (Cash)
                </a>
                <a asp-controller="MassIntention" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-journal-check"></i> Mass Intentions
                </a>
                <a asp-controller="Document" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-file-earmark-word"></i> Export Documents
                </a>
                <!-- BAGONG ADDED LINK DITO -->
                <a asp-controller="Document" asp-action="History" class="sd-nav-link">
                    <i class="bi bi-clock-history"></i> Intentions History
                </a>

                <small class="text-white-50 text-uppercase px-3 mt-3 mb-1" style="font-size:.65rem; letter-spacing:.08em;">Parish</small>
                <a asp-controller="Schedule" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-calendar-event"></i> Schedules
                </a>
                <a asp-controller="Priest" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-person-badge"></i> Priests
                </a>
                <a asp-controller="Announcement" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-megaphone"></i> Announcements
                </a>
                <a asp-controller="Report" asp-action="Index" class="sd-nav-link">
                    <i class="bi bi-bar-chart"></i> Reports
                </a>
            </nav>

            <div class="p-3 border-top border-white border-opacity-10">
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light w-100 rounded-xl btn-sm">
                    <i class="bi bi-box-arrow-left me-1"></i> Log out
                </a>
            </div>
        </aside>

        <!-- Main content -->
        <div class="w-100" id="page-content-wrapper">
            <div class="d-flex align-items-center justify-content-between bg-white border-bottom px-4 py-2 d-lg-none">
                <button class="btn btn-sm btn-sd-outline" id="sd-sidebar-toggle"><i class="bi bi-list fs-5"></i></button>
                <span class="fw-bold text-navy font-display">Santo Domingo Admin</span>
                <span></span>
            </div>
            <main role="main" class="p-3 p-lg-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sd-sidebar-toggle')?.addEventListener('click', function () {
            document.getElementById('sd-sidebar').classList.toggle('d-none');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>