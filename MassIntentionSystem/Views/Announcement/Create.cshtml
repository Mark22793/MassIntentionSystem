@model MassIntentionSystem.Models.Announcement
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bagong Anunsyo";
}

<div class="row justify-content-center fade-up">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold font-display text-navy m-0">Mag-post ng Bagong Anunsyo</h4>
            <a asp-action="Index" class="btn btn-sd-outline btn-sm"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
        </div>

        <form asp-controller="Announcement" asp-action="Create" method="post" class="sd-card shadow-md-sd p-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <div class="sd-field sd-field-noicon">
                    <input asp-for="Title" class="form-control" placeholder=" " required />
                    <label asp-for="Title">Pamagat ng Anunsyo</label>
                </div>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="sd-field sd-field-noicon">
                    <textarea asp-for="Content" class="form-control" rows="6" placeholder=" " required></textarea>
                    <label asp-for="Content">Nilalaman (Content)</label>
                </div>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch p-3 rounded-2xl mb-4" style="background:var(--sd-bg);">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label fw-semibold">I-publish agad sa Public Website</label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-sd-outline">Kanselahin</a>
                <button type="submit" class="btn btn-sd-primary px-4"><i class="bi bi-save me-1"></i> I-save ang Anunsyo</button>
            </div>
        </form>
    </div>
</div>