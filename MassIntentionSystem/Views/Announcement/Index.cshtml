@model IEnumerable<MassIntentionSystem.Models.Announcement>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pamamahala ng Anunsyo";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 fade-up">
    <div>
        <h3 class="fw-bold font-display text-navy m-0">Mga Anunsyo ng Simbahan</h3>
        <p class="text-muted small mb-0">Mag-post o mag-edit ng mga anunsyong ipinapakita sa public website.</p>
    </div>
    <a asp-controller="Announcement" asp-action="Create" class="btn btn-sd-primary">
        <i class="bi bi-plus-circle me-1"></i> Gumawa ng Bagong Anunsyo
    </a>
</div>

<div class="sd-card shadow-soft fade-up">
    <div class="table-responsive">
        <table class="table table-sd table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Petsa ng Pag-post</th>
                    <th>Pamagat (Title)</th>
                    <th>Status</th>
                    <th class="text-center">Aksyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-megaphone fs-1 d-block mb-2 text-secondary"></i>
                            Walang nahanap na anunsyo. I-click ang button sa taas para mag-add.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong class="text-navy">@item.DatePosted.ToString("MMM dd, yyyy")</strong></td>
                            <td class="fw-semibold">@item.Title</td>
                            <td>
                                @if (item.IsActive)
                                { <span class="badge badge-status-verified rounded-pill px-3 py-2">Naka-publish</span> }
                                else
                                { <span class="badge bg-light text-dark border rounded-pill px-3 py-2">Naka-draft</span> }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-sd-outline me-1"><i class="bi bi-pencil"></i> Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Tingnan</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>