@model IEnumerable<MassIntentionSystem.Models.Announcement>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pamamahala ng Anunsyo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0" style="color: #4a154b;">Mga Anunsyo ng Simbahan</h3>
        <p class="text-muted small mb-0">Mag-post o mag-edit ng mga anunsyong ipinapakita sa public website.</p>
    </div>
    <a asp-controller="Announcement" asp-action="Create" class="btn btn-violet fw-bold">
        ➕ Gumawa ng Bagong Anunsyo
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-admin mb-0">
            <thead>
                <tr>
                    <th>Petsa ng Pag-post</th>
                    <th>Pamagat (Title)</th>
                    <th>Status</th>
                    <th class="text-center">Aksyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            Walang nahanap na anunsyo. I-click ang button sa taas para mag-add.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.DatePosted.ToString("MMM dd, yyyy")</strong></td>
                            <td class="fw-semibold">@item.Title</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Naka-publish</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Naka-draft</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Announcement" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    ✏️ Edit
                                </a>
                                <a asp-controller="Announcement" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    👁️ Tingnan
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>