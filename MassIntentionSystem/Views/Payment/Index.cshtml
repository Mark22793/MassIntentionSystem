@model IEnumerable<MassIntentionSystem.Models.Payment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payment Verification List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0" style="color: #4a154b;">💳 Payment Verification</h3>
        <p class="text-muted small mb-0">Talaan ng lahat ng GCash/Maya transactions para sa Mass Intentions.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-admin mb-0">
                <thead>
                    <tr>
                        <th>Ref No</th>
                        <th>Halaga (Amount)</th>
                        <th>Petsa ng Bayad</th>
                        <th>Proof of Payment</th>
                        <th>Status</th>
                        <th class="text-center">Aksyon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MassIntention?.ReferenceNo</strong></td>
                            <td>₱@item.Amount.ToString("N2")</td>
                            <td>@item.PaymentDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProofOfPaymentPath))
                                {
                                    <a href="@item.ProofOfPaymentPath" target="_blank" class="btn btn-sm btn-outline-primary">🖼️ Silipin Image</a>
                                }
                                else
                                {
                                    <span class="text-muted small">Walang Proof</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.IsVerified ? "bg-success" : "bg-warning text-dark")">
                                    @(item.IsVerified ? "Verified" : "Pending")
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">👁️ Detalye</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>