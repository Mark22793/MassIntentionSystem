@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Logout Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 text-center p-4">
                <div class="card-body">
                    <div class="stat-icon mb-3 text-warning">
                        🔒
                    </div>
                    <h4 class="fw-bold text-dark">Gusto mo bang mag-logout?</h4>
                    <p class="text-muted small mb-4">
                        Siguraduhing naisaayos mo na ang lahat ng Mass Intentions at encoding bago lumabas sa portal.
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4 fw-semibold">
                            Oo, Mag-Logout
                        </a>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4">
                            Kanselahin
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>