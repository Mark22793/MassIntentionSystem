@model IEnumerable<MassIntentionSystem.Models.MassSchedule>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mass Schedule Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-2xl border-0 shadow-soft d-flex align-items-center gap-2 fade-up">
        <i class="bi bi-check-circle-fill"></i> <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 fade-up">
    <div>
        <h3 class="fw-bold font-display text-navy m-0"><i class="bi bi-calendar-event text-gold me-2"></i>Pamamahala ng Oras ng Misa</h3>
        <p class="text-muted small mb-0">I-manage ang mga time slot at i-assign ang officiating priests.</p>
    </div>
    <a asp-action="Create" class="btn btn-sd-primary"><i class="bi bi-plus-circle me-1"></i> Magdagdag ng Schedule Slot</a>
</div>

<div class="sd-card shadow-soft fade-up">
    <div class="table-responsive">
        <table class="table table-sd table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Araw</th>
                    <th>Oras</th>
                    <th>Wika</th>
                    <th>Pari</th>
                    <th class="text-center">Aksyon</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                        Wala pang naitalang schedule slot.
                    </td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-navy">@item.DayOfWeek</td>
                            <td><span class="badge bg-light text-dark border rounded-pill px-3 py-2"><i class="bi bi-clock me-1"></i>@DateTime.Today.Add(item.Time).ToString("hh:mm tt")</span></td>
                            <td class="text-muted">@item.Language</td>
                            <td>
                                @if (item.Priest != null)
                                { <span class="text-navy fw-semibold">@item.Priest.Name</span> }
                                else
                                { <span class="text-muted small fst-italic">Wala pang nakatalaga</span> }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-sd-outline me-1"><i class="bi bi-pencil"></i> Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalye</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>