@model MassIntentionSystem.Models.MassSchedule
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Schedule Slot";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <h4 class="fw-bold mb-3" style="color: #4a154b;">✏️ Edit Mass Schedule</h4>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="DayOfWeek" class="form-label fw-semibold">Araw</label>
                        <select asp-for="DayOfWeek" class="form-select" required>
                            <option value="Monday">Lunes</option>
                            <option value="Tuesday">Martes</option>
                            <option value="Wednesday">Miyerkules</option>
                            <option value="Thursday">Huwebes</option>
                            <option value="Friday">Biyernes</option>
                            <option value="Saturday">Sabado</option>
                            <option value="Sunday">Linggo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Time" class="form-label fw-semibold">Oras</label>
                        <input asp-for="Time" type="time" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Language" class="form-label fw-semibold">Wika</label>
                        <input asp-for="Language" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="PriestId" class="form-label fw-semibold">Officiating Priest</label>
                        <select asp-for="PriestId" class="form-select" asp-items="ViewBag.PriestId">
                            <option value="">-- Pumili ng Pari --</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Kanselahin</a>
                        <button type="submit" class="btn btn-success fw-bold">I-update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>