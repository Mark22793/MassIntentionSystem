@model MassIntentionSystem.Models.MassSchedule
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gumawa ng Schedule";
}

<div class="row justify-content-center fade-up">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold font-display text-navy m-0">Magdagdag ng Mass Schedule Slot</h4>
            <a asp-action="Index" class="btn btn-sd-outline btn-sm"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
        </div>

        <form asp-action="Create" method="post" class="sd-card shadow-md-sd p-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <div class="sd-field">
                    <i class="bi bi-calendar-week sd-icon"></i>
                    <select asp-for="DayOfWeek" class="form-select" required>
                        <option value="Monday">Lunes (Monday)</option>
                        <option value="Tuesday">Martes (Tuesday)</option>
                        <option value="Wednesday">Miyerkules (Wednesday)</option>
                        <option value="Thursday">Huwebes (Thursday)</option>
                        <option value="Friday">Biyernes (Friday)</option>
                        <option value="Saturday">Sabado (Saturday)</option>
                        <option value="Sunday">Linggo (Sunday)</option>
                    </select>
                    <label asp-for="DayOfWeek">Araw (Day of Week)</label>
                </div>
            </div>
            <div class="mb-3">
                <div class="sd-field">
                    <i class="bi bi-clock sd-icon"></i>
                    <input asp-for="Time" type="time" class="form-control" placeholder=" " required />
                    <label asp-for="Time">Oras (Time Slot)</label>
                </div>
            </div>
            <div class="mb-3">
                <div class="sd-field">
                    <i class="bi bi-translate sd-icon"></i>
                    <input asp-for="Language" class="form-control" placeholder=" " required />
                    <label asp-for="Language">Wika (Tagalog / English)</label>
                </div>
            </div>
            <div class="mb-4">
                <div class="sd-field">
                    <i class="bi bi-person-badge sd-icon"></i>
                    <select asp-for="PriestId" class="form-select" asp-items="ViewBag.PriestId">
                        <option value="">-- Pumili ng Pari (Optional) --</option>
                    </select>
                    <label asp-for="PriestId">Officiating Priest</label>
                </div>
            </div>
            <div class="form-check form-switch p-3 rounded-2xl mb-4" style="background:var(--sd-bg);">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label fw-semibold">Active (ipapakita sa public schedule)</label>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-sd-outline">Kanselahin</a>
                <button type="submit" class="btn btn-sd-primary px-4"><i class="bi bi-save me-1"></i> I-save Schedule</button>
            </div>
        </form>
    </div>
</div>