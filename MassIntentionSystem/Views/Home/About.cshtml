@{
    ViewData["Title"] = "Tungkol sa Parokya";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="fw-bold mb-3" style="color: #4a154b;">Tungkol sa Santo Domingo Church</h2>
            <p class="lead text-secondary">National Shrine of Our Lady of the Holy Rosary of La Naval de Manila</p>
            <hr class="gold-border-bottom mb-4" />

            <p style="line-height: 1.8;">
                Ang Simbahan ng Santo Domingo ay ang pambansang dambana ng Mahal na Birhen ng La Naval de Manila. Pinamamahalaan ito ng mga Paring Dominiko (Order of Preachers). Layunin ng online Mass Intention Web System na ito na mapadali ang pag-aalay ng Misa para sa mga deboto saanman sa mundo.
            </p>
        </div>
    </div>
</div>