@model IEnumerable<MassIntentionSystem.Models.MassSchedule>
@{
    ViewData["Title"] = "Oras ng mga Misa";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: #4a154b;">Jornada / Oras ng Misa</h2>
        <p class="text-muted">Santo Domingo Church Mass Schedules</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead style="background-color: #4a154b; color: white;">
                            <tr>
                                <th>Araw (Day)</th>
                                <th>Oras (Time)</th>
                                <th>Wika (Language)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var sched in Model)
                                {
                                    <tr>
                                        <td><strong>@sched.DayOfWeek</strong></td>
                                        <td>@DateTime.Today.Add(sched.Time).ToString("hh:mm tt")</td>
                                        <td>@sched.Language</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">Lunes hanggang Linggo: 6:00 AM - 7:00 PM</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>